IMAGE_PROVIDER=huggingface
# Optional: leave blank for anonymous public-Space access. If using a Read token,
# paste it only into serveur/.env. Never commit a real token.
HF_TOKEN=
# Public FLUX.1 Schnell Space; clones must expose the same /infer inputs.
HF_SPACE_ID=black-forest-labs/FLUX.1-schnell
PORT=8080

# Optional photorealistic live try-on. OFF by default; no paid fallback is used.
# Hugging Face tokens cannot run this Decart video model.
# Enable only after accepting Decart credit usage ($0.02/sec in standard mode).
TRYON_ENABLED=false
DECART_API_KEY=
# Each session is capped at 60 seconds (10-60 accepted; larger values are clamped).
TRYON_SESSION_SECONDS=60
# Canonical origins only: no trailing slash, path, credentials, or wildcard.
# Leave blank for localhost / 127.0.0.1 / ::1 on Vite ports 5173 and 5174.
# Public origins must use HTTPS. Example: https://your-website.example
TRYON_ALLOWED_ORIGINS=
# At least 16 random characters. Required for remote callers, reverse proxies,
# and production. Never put this or DECART_API_KEY in a VITE_* variable.
# If configured, this code is required locally too. Leave blank for local-only use.
TRYON_ACCESS_CODE=
# Server limits: 3 token starts / 10 minutes per source IP, 6 / hour globally.
# Limits are in memory for this single-server demo; use authenticated shared
# quotas before running multiple servers. Client tokens can start more than one
# connection before their 30-second expiry; cap concurrency in Decart as well.
